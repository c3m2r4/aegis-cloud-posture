# Configuration reference for local Floci. AEGIS loads a nearby .env file;
# exported shell variables take precedence over values in the file.
# Credentials are intentionally omitted. Configure them through boto3's standard
# providers (for example an AWS profile); never put credentials in this file.
AEGIS_ENDPOINT_URL=http://127.0.0.1:4566
AEGIS_REGION=us-east-1
AEGIS_DATABASE=./aegis.db
AEGIS_CONNECT_TIMEOUT=3
AEGIS_READ_TIMEOUT=8
# Set to 1 only to enable opt-in read-only integration tests against local Floci.
AEGIS_RUN_INTEGRATION=0
# For a local Floci instance, configure its dummy credentials in ignored .env
# or select a local Floci profile. Never use emulator credentials with real AWS.
